# ==========================================================
# MALHAR Cultural Club - Environment Configuration Template
# ==========================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# 1. Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://bnoxmpinrekbsivcdady.supabase.co

# 2. Supabase Publishable / Anon Key (Public - Browser & Client Components)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key_here

# 3. Supabase Service Role Key (Secret - Server Actions & Admin SSR Client Only)
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here

# 4. Site URL / Base Domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Google OAuth 2.0 Credentials (Admin Sign-In)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
